{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/requestPasswordRecovery",
        "function": {
          "functionId": "requestPasswordRecovery",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/confirmPasswordRecovery",
        "function": {
          "functionId": "confirmPasswordRecovery",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/changePasswordWithCurrentPassword",
        "function": {
          "functionId": "changePasswordWithCurrentPassword",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/registerDigitalCertificate",
        "function": {
          "functionId": "registerDigitalCertificate",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/deleteDigitalCertificate",
        "function": {
          "functionId": "deleteDigitalCertificate",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/verifyDigitalCertificatePassword",
        "function": {
          "functionId": "verifyDigitalCertificatePassword",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/signPdfWithDigitalCertificate",
        "function": {
          "functionId": "signPdfWithDigitalCertificate",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tesis-intesud",
          "appId": "1:18141359679:android:395b40a340b236dfcc528a",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tesis-intesud",
          "configurations": {
            "android": "1:18141359679:android:395b40a340b236dfcc528a",
            "ios": "1:18141359679:ios:53910b469d41616ecc528a",
            "macos": "1:18141359679:ios:53910b469d41616ecc528a",
            "web": "1:18141359679:web:7cb520b73faa2c9acc528a",
            "windows": "1:18141359679:web:c9814998c682e7dbcc528a"
          }
        }
      }
    }
  }
}
